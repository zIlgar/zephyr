#include <zephyr/kernel.h>
#include <zephyr/device.h>
#include <zephyr/drivers/gpio.h>
#include <zephyr/drivers/led_strip.h>
#include <zephyr/random/random.h>
#include <stdio.h>

#define STRIP_LEN 10

static const struct gpio_dt_spec b1 = GPIO_DT_SPEC_GET(DT_NODELABEL(btn_a), gpios);
static const struct gpio_dt_spec b2 = GPIO_DT_SPEC_GET(DT_NODELABEL(btn_b), gpios);
static const struct gpio_dt_spec b3 = GPIO_DT_SPEC_GET(DT_NODELABEL(btn_c), gpios);

static const struct device *strip = DEVICE_DT_GET_ANY(sk6812);
static struct led_rgb strip_colors[STRIP_LEN];

int user_score = 0;
int comp_score = 0;

void set_strip(uint8_t r, uint8_t g, uint8_t b)
{
    for (int i = 0; i < STRIP_LEN; i++) {
        strip_colors[i].r = r;
        strip_colors[i].g = g;
        strip_colors[i].b = b;
    }
    led_strip_update_rgb(strip, strip_colors, STRIP_LEN);
}

void play(int my_choice)
{
    int pc_choice = sys_rand32_get() % 3;

    if (my_choice == 0) {
        printf("You chose: Rock\n");
    } else if (my_choice == 1) {
        printf("You chose: Paper\n");
    } else {
        printf("You chose: Scissors\n");
    }

    if (pc_choice == 0) {
        printf("Computer chose: Rock\n");
    } else if (pc_choice == 1) {
        printf("Computer chose: Paper\n");
    } else {
        printf("Computer chose: Scissors\n");
    }

    if (my_choice == pc_choice) {
        printf("Draw!\n");
        set_strip(25, 25, 25);
    } else if ((my_choice == 0 && pc_choice == 2) ||
               (my_choice == 1 && pc_choice == 0) ||
               (my_choice == 2 && pc_choice == 1)) {
        user_score++;
        printf("You won!\n");
        set_strip(0, 50, 0);
    } else {
        comp_score++;
        printf("Computer won!\n");
        set_strip(50, 0, 0);
    }

    printf("Score -> You: %d | PC: %d\n\n", user_score, comp_score);

    k_msleep(2000);
    set_strip(25, 25, 25);
}

int main(void)
{
    gpio_pin_configure_dt(&b1, GPIO_INPUT);
    gpio_pin_configure_dt(&b2, GPIO_INPUT);
    gpio_pin_configure_dt(&b3, GPIO_INPUT);

    set_strip(25, 25, 25);

    printf("Game started! Press Rock (1), Paper (2), or Scissors (3)\n");

    while (1) {
        if (gpio_pin_get_dt(&b1) > 0) {
            play(0);
            while (gpio_pin_get_dt(&b1) > 0) {
                k_msleep(50);
            }
        } else if (gpio_pin_get_dt(&b2) > 0) {
            play(1);
            while (gpio_pin_get_dt(&b2) > 0) {
                k_msleep(50);
            }
        } else if (gpio_pin_get_dt(&b3) > 0) {
            play(2);
            while (gpio_pin_get_dt(&b3) > 0) {
                k_msleep(50);
            }
        }

        k_msleep(50);
    }

    return 0;
}
